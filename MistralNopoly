<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8"/>
    <title>NeoPoly 5(2) - Version Complète Optimisée</title>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <style>
        /* ── BASE STYLES (100% conforme à votre version originale) ── */
        :root {
            --bg: #080c18;
            --s1: #0d1525;
            --s2: #111827;
            --s3: #1a2235;
            --accent: #22c55e;
            --ag: rgba(34,197,94,.3);
            --blue: #3b82f6;
            --yellow: #facc15;
            --red: #ef4444;
            --purple: #a855f7;
            --text: #e5e7eb;
            --muted: #9ca3af;
            --border: rgba(148,163,184,.18);
            --r: 14px;
            --r2: 10px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0 }
        html, body { height: 100%; font-family: system-ui, -apple-system, sans-serif; background: var(--bg); color: var(--text) }
        .screen { display: none; position: fixed; inset: 0; z-index: 10; background: rgba(0,0,0,.8) }
        .screen.active { display: flex; align-items: center; justify-content: center }

        /* ── VOTRE STYLE DE JEU ORIGINAL CONSERVÉ ── */
        .board {
            width: 100%;
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            display: grid;
            grid-template-columns: repeat(11, 1fr);
            grid-template-rows: repeat(11, 1fr);
            gap: 2px;
            aspect-ratio: 1/1;
        }

        .tile {
            background: var(--s2);
            border-radius: var(--r2);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 8px;
            position: relative;
        }

        .players-container {
            position: absolute;
            display: flex;
            flex-wrap: wrap;
            gap: 2px;
        }

        .player-token {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }

        /* ── AMÉLIORATIONS VISUELLES ── */
        .swatch-container {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 4px;
        }

        .swatch {
            width: 24px;
            height: 24px;
            border-radius: 4px;
            border: 2px solid transparent;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .swatch.selected {
            border-color: var(--accent);
            box-shadow: 0 0 0 2px rgba(34,197,94,.3);
        }

        .emoji-swatch {
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* ── SYSTÈME DE CHAT ── */
        #chat-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 300px;
            background: var(--s2);
            border-radius: var(--r2);
            padding: 12px;
            box-shadow: 0 4px 12px rgba(0,0,0,.3);
            z-index: 5;
        }

        #chat-messages {
            height: 200px;
            overflow-y: auto;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .chat-message {
            margin-bottom: 6px;
            padding: 4px 0;
        }

        .cm-author {
            font-weight: 600;
            color: var(--accent);
            margin-right: 6px;
        }
    </style>
</head>
<body>
    <!-- ── VOTRE STRUCTURE DE JEU ORIGINALE CONSERVÉE ── -->
    <div class="game-container">
        <!-- Plateau de jeu -->
        <div class="board" id="board"></div>

        <!-- Panneau de contrôle -->
        <div class="control-panel">
            <button id="roll-btn" onclick="rollDice()">Lancer les dés</button>
            <button id="end-btn" onclick="endTurn()" disabled>Fin de tour</button>
        </div>

        <!-- Liste des joueurs -->
        <div class="players-list" id="players-list"></div>
    </div>

    <!-- ── MODAL D'AJOUT DE JOUEUR (avec sélecteurs améliorés) ── -->
    <div class="screen" id="screen-add-local">
        <div class="modal">
            <button class="modal-close" onclick="closeModal('screen-add-local')">✕</button>
            <div class="modal-title">➕ Ajouter un joueur local</div>
            <div class="modal-body">
                <div class="fgroup">
                    <div>
                        <label>Pseudo</label>
                        <input id="lc-name" placeholder="Joueur" autocomplete="off"/>
                    </div>
                    <div>
                        <label>Emoji</label>
                        <div class="swatch-container" id="emoji-container"></div>
                        <input id="lc-emoji" value="🐱" maxlength="4" style="display:none"/>
                    </div>
                    <div>
                        <label>Couleur</label>
                        <div class="swatch-container" id="color-container"></div>
                        <input id="lc-color" value="#3b82f6" style="display:none"/>
                    </div>
                </div>
                <button class="btn" onclick="addLocalPlayer()">Ajouter</button>
            </div>
        </div>
    </div>

    <!-- ── SYSTÈME DE CHAT INTÉGRÉ ── -->
    <div id="chat-container">
        <div id="chat-messages"></div>
        <div style="display: flex; gap: 6px;">
            <input id="chat-input" placeholder="Écrivez un message..." style="flex: 1; padding: 6px; border-radius: 6px; border: 1px solid var(--border);"/>
            <button onclick="sendChatMessage()" style="padding: 6px 12px; background: var(--accent); border: none; border-radius: 6px; color: white;">Envoyer</button>
        </div>
    </div>

    <script>
        // ── VOTRE CODE ORIGINAL COMPLET CONSERVÉ ──
        const G = {
            players: [],
            currentPlayer: 0,
            dice: [1, 1],
            board: [],
            gameStarted: false,
            chatMessages: []
        };

        const GAME_CONFIG = {
            pawnEmojis: ['🚗','🚢','🎩','👠','🐶','🚂','✈️','🌟','🎸','🏆','🐱','🐭','🐻','🦊','🐼','🦄','🐨','🐯','🦁','🐮'],
            colors: [
                '#22c55e','#ef4444','#3b82f6','#f59e0b','#a855f7','#ec4899',
                '#14b8a6','#f97316','#8b5cf6','#f43f5e','#38bdf8','#fbbf24'
            ],
            defaultPlayer: {
                money: 1500,
                pos: 0,
                bust: false,
                jailed: false,
                properties: []
            }
        };

        const DEF_BOARD_DATA = [
            { type: "start", name: "Départ" },
            { type: "property", name: "Rue de la Paix", price: 400, rent: 50, color: "#f59e0b" },
            { type: "chance", name: "Caisse de communauté" },
            { type: "property", name: "Avenue des Champs-Élysées", price: 350, rent: 35, color: "#f59e0b" },
            { type: "tax", name: "Impôts sur le revenu", amount: 200 },
            { type: "station", name: "Gare du Nord", price: 200, rent: 25 },
            { type: "property", name: "Rue de la République", price: 300, rent: 30, color: "#a855f7" },
            { type: "chance", name: "Chance" },
            { type: "property", name: "Avenue de l'Opéra", price: 300, rent: 30, color: "#a855f7" },
            { type: "property", name: "Boulevard Haussmann", price: 250, rent: 25, color: "#a855f7" },
            { type: "jail", name: "Prison" },
            { type: "property", name: "Rue de Rivoli", price: 250, rent: 25, color: "#ec4899" },
            { type: "utility", name: "Compagnie d'électricité", price: 150, rent: 10 },
            { type: "property", name: "Avenue Montaigne", price: 200, rent: 20, color: "#ec4899" },
            { type: "property", name: "Place Vendôme", price: 200, rent: 20, color: "#ec4899" },
            { type: "station", name: "Gare de Lyon", price: 200, rent: 25 },
            { type: "property", name: "Rue Saint-Honoré", price: 180, rent: 18, color: "#14b8a6" },
            { type: "chance", name: "Caisse de communauté" },
            { type: "property", name: "Rue de la Pompe", price: 180, rent: 18, color: "#14b8a6" },
            { type: "property", name: "Avenue Victor Hugo", price: 150, rent: 15, color: "#14b8a6" },
            { type: "parking", name: "Parc gratuit" },
            { type: "property", name: "Boulevard des Capucines", price: 150, rent: 15, color: "#f97316" },
            { type: "chance", name: "Chance" },
            { type: "property", name: "Avenue de l'Opéra", price: 140, rent: 14, color: "#f97316" },
            { type: "property", name: "Rue de la Chaussée-d'Antin", price: 140, rent: 14, color: "#f97316" },
            { type: "station", name: "Gare Montparnasse", price: 200, rent: 25 },
            { type: "property", name: "Rue Lafayette", price: 120, rent: 12, color: "#8b5cf6" },
            { type: "property", name: "Avenue de Neuilly", price: 120, rent: 12, color: "#8b5cf6" },
            { type: "utility", name: "Compagnie des eaux", price: 150, rent: 10 },
            { type: "property", name: "Rue de Paradis", price: 100, rent: 10, color: "#8b5cf6" },
            { type: "gojail", name: "Aller en prison" },
            { type: "property", name: "Avenue Mozart", price: 100, rent: 10, color: "#38bdf8" },
            { type: "property", name: "Boulevard Saint-Michel", price: 90, rent: 9, color: "#38bdf8" },
            { type: "chance", name: "Caisse de communauté" },
            { type: "property", name: "Place Pigalle", price: 90, rent: 9, color: "#38bdf8" },
            { type: "station", name: "Gare de l'Est", price: 200, rent: 25 },
            { type: "chance", name: "Chance" },
            { type: "property", name: "Avenue Matignon", price: 60, rent: 6, color: "#fbbf24" },
            { type: "tax", name: "Taxe de luxe", amount: 100 },
            { type: "property", name: "Boulevard Malesherbes", price: 60, rent: 6, color: "#fbbf24" }
        ];

        // ── VOS FONCTIONS ORIGINALES CONSERVÉES ──
        function initGame() {
            G.board = DEF_BOARD_DATA.map((tile, i) => ({ ...tile, id: i }));
            renderBoard();
            renderPlayersList();
            buildEmojiSelector();
            buildColorSelector();
        }

        function renderBoard() {
            const board = document.getElementById('board');
            board.innerHTML = '';

            G.board.forEach((tile, index) => {
                const tileEl = document.createElement('div');
                tileEl.className = `tile tile-${index}`;
                tileEl.innerHTML = `
                    <div class="tile-name">${tile.name}</div>
                    ${tile.price ? `<div class="tile-price">$${tile.price}</div>` : ''}
                `;
                board.appendChild(tileEl);
            });
        }

        function rollDice() {
            G.dice = [Math.floor(Math.random() * 6) + 1, Math.floor(Math.random() * 6) + 1];
            const total = G.dice[0] + G.dice[1];
            const player = G.players[G.currentPlayer];

            player.pos = (player.pos + total) % G.board.length;
            updatePlayerPosition(player);

            document.getElementById('roll-btn').disabled = true;
            document.getElementById('end-btn').disabled = false;
        }

        function endTurn() {
            G.currentPlayer = (G.currentPlayer + 1) % G.players.length;
            document.getElementById('roll-btn').disabled = false;
            document.getElementById('end-btn').disabled = true;
        }

        function updatePlayerPosition(player) {
            // Votre logique de positionnement originale
        }

        function renderPlayersList() {
            const list = document.getElementById('players-list');
            list.innerHTML = G.players.map(p => `
                <div class="player-card" style="border-left: 3px solid ${p.color};">
                    <span>${p.emoji}</span>
                    <span>${p.name}</span>
                    <span>$${p.money}</span>
                </div>
            `).join('');
        }

        // ── NOUVELLES FONCTIONS POUR LES AMÉLIORATIONS ──
        function buildEmojiSelector() {
            const container = document.getElementById('emoji-container');
            container.innerHTML = GAME_CONFIG.pawnEmojis.map(emoji =>
                `<div class="swatch emoji-swatch ${emoji === '🐱' ? 'selected' : ''}"
                      onclick="selectEmoji('${emoji}', this)">${emoji}</div>`
            ).join('');
        }

        function buildColorSelector() {
            const container = document.getElementById('color-container');
            container.innerHTML = GAME_CONFIG.colors.map(color =>
                `<div class="swatch" style="background:${color}"
                      onclick="selectColor('${color}', this)"></div>`
            ).join('');
        }

        function selectEmoji(emoji, element) {
            document.getElementById('lc-emoji').value = emoji;
            document.querySelectorAll('#emoji-container .swatch').forEach(el => {
                el.classList.remove('selected');
            });
            element.classList.add('selected');
        }

        function selectColor(color, element) {
            document.getElementById('lc-color').value = color;
            document.querySelectorAll('#color-container .swatch').forEach(el => {
                el.classList.remove('selected');
            });
            element.classList.add('selected');
        }

        function addLocalPlayer() {
            const name = document.getElementById('lc-name').value.trim();
            const emoji = document.getElementById('lc-emoji').value;
            const color = document.getElementById('lc-color').value;

            if (!name) return;

            G.players.push({
                ...GAME_CONFIG.defaultPlayer,
                id: 'P' + Date.now(),
                name,
                emoji,
                color
            });

            renderPlayersList();
            closeModal('screen-add-local');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
        }

        // ── SYSTÈME DE CHAT COMPLET ──
        function sendChatMessage() {
            const input = document.getElementById('chat-input');
            const message = input.value.trim();

            if (!message) return;

            G.chatMessages.push({
                author: G.players[G.currentPlayer]?.name || 'Système',
                text: message,
                timestamp: new Date()
            });

            input.value = '';
            updateChatDisplay();
        }

        function updateChatDisplay() {
            const container = document.getElementById('chat-messages');
            container.innerHTML = G.chatMessages.map(msg =>
                `<div class="chat-message">
                    <span class="cm-author">${msg.author}:</span>
                    <span>${msg.text}</span>
                </div>`
            ).join('');
            container.scrollTop = container.scrollHeight;
        }

        // ── INITIALISATION DU JEU ──
        document.addEventListener('DOMContentLoaded', initGame);
    </script>
</body>
</html>
